rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Projects collection
    match /projects/{projectId} {
      allow read: if true;  // Anyone can read (for public portfolio)
      allow write: if isAuthenticated();  // Only authenticated users can write
    }
    
    // Artworks collection
    match /artworks/{artworkId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // Content collection (About, Skills, etc.)
    match /content/{contentId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // Featured items
    match /featured/{itemId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // Tag collections
    match /technologies/{techId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    match /features/{featureId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    match /artTags/{tagId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}