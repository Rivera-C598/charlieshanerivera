rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is admin (specific email)
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email == 'charlieshane57@gmail.com';
    }
    
    // Projects collection
    match /projects/{projectId} {
      allow read: if true;  // Anyone can read
      allow create, update, delete: if isAuthenticated();  // Any authenticated user can write
    }
    
    // Artworks collection
    match /artworks/{artworkId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }
    
    // Content collection (About, Skills, etc.)
    match /content/{contentId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }
    
    // Featured items
    match /featured/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }
  }
}